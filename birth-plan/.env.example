# (https://myaccount.google.com/apppasswords, needs 2-Step Verification on)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who receives every finished plan (comma separated)
PLAN_EMAIL_TO=Daske2725@gmail.com,kidaryogev@gmail.com

# ── WhatsApp (Green API, https://green-api.com) ──────────────────────────────
WA_GREENAPI_INSTANCE=
WA_GREENAPI_TOKEN=
# Who gets the WhatsApp summary + PDF (comma separated). Default: Hadas
WA_NOTIFY_PHONES=972542299787
