# ── e-mail (Vercel → Settings → Environment Variables) ───────────────────────
# Gmail account that sends the plan + an App Password (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where finished plans are sent (default: Yogev)
PLAN_EMAIL_TO=kidaryogev@gmail.com

# ── WhatsApp to the doula (baked into the client at build time) ──────────────
# International format, digits only, e.g. 972501234567
VITE_DOULA_PHONE=
